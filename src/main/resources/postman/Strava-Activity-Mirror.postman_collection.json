					}
				}
			]
		},
		{
			"name": "Activity Detail",
			"item": [
				{
					"name": "Detail — By ID (from collection variable)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has detail fields', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('activity_id');",
									"    pm.expect(json).to.have.property('start_time');",
